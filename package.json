{
  "name": "austin-resume",
  "private": true,
  "description": "Source for resume.austinhenry.dev — a static resume site built from resume.json and served from Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:html": "htmlhint \"dist/**/*.html\"",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run lint && npm run build && npm run lint:html && npm test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "preview": "wrangler preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.147.0"
  }
}
