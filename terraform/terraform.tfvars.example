cloudflare_account_id = "your-account-id" # Dashboard → Workers & Pages → right sidebar
cloudflare_zone_id    = "your-zone-id"    # Dashboard → the zone → Overview → right sidebar
hostname              = "resume.yourdomain.com"
apex_hostname         = "yourdomain.com"
worker_name           = "austin-resume"

# Never put the API token here. Export it instead:
#   export TF_VAR_cloudflare_api_token="..."
